<Window x:Class="Balancer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Balancer.Wpf"
        mc:Ignorable="d"
        Title="双平面动平衡仿真与标定" Height="780" Width="1250" MinHeight="640" MinWidth="1000">
    <Grid Background="#F3F6F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
        <Border Background="#17324D" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="双平面动平衡仿真与标定"/><TextBlock Foreground="#BFD7EA" Text="影响系数法 · 两测点 / 两校正面"/></StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Foreground="White" Text="{Binding ConnectionStatus}"/><TextBlock Foreground="#BFD7EA" Text="{Binding SystemStatus}"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <GroupBox Header="配方与连接" Margin="0,0,0,12"><StackPanel Margin="10">
                    <TextBlock Text="当前配方"/><ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" Margin="0,4,0,8"/>
                    <Button Content="保存配方" Command="{Binding SaveRecipeCommand}"/>
                    <TextBlock Margin="0,12,0,0" Text="目标转速 (RPM)"/><TextBox Text="{Binding TargetRpm, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    <Button Content="连接仿真采集源" Command="{Binding ConnectCommand}"/>
                </StackPanel></GroupBox>
                <GroupBox Header="标定向导"><StackPanel Margin="10">
                    <TextBlock FontWeight="Bold" Text="{Binding CurrentStep}"/><TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Text="请确保每次试验均以相同转速采集，并在开始下一步前移除上一平面的试重。"/>
                    <Button Content="开始采集" Command="{Binding StartAcquisitionCommand}" Margin="0,0,0,6"/>
                    <Button Content="记录当前步骤" Command="{Binding RecordStepCommand}" Margin="0,0,0,6"/>
                    <Button Content="计算两面校正" Command="{Binding CalculateCorrectionCommand}"/>
                </StackPanel></GroupBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <GroupBox Header="实时测量摘要" Height="255"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="实测 RPM"/><TextBlock Grid.Column="1" FontSize="24" FontWeight="Bold" Text="{Binding MeasuredRpm, StringFormat={}{0:F1}}"/><TextBlock Grid.Column="2" Text="信号质量：等待采集" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="测点 A：1X 幅值 / 相位"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PiezoAAmplitude, StringFormat={}{0:F3}}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PiezoAPhase, StringFormat={}{0:F1}°}"/>
                    <TextBlock Grid.Row="2" Text="测点 B：1X 幅值 / 相位"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PiezoBAmplitude, StringFormat={}{0:F3}}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PiezoBPhase, StringFormat={}{0:F1}°}"/>
                </Grid></GroupBox>
                <GroupBox Header="振动矢量（键相为 0°）" Margin="0,12,0,0"><Grid Height="250"><Ellipse Width="190" Height="190" Stroke="#8AA4BA" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Line X1="30" Y1="125" X2="430" Y2="125" Stroke="#CAD7E2"/><Line X1="230" Y1="20" X2="230" Y2="230" Stroke="#CAD7E2"/><TextBlock Text="示意：实时矢量图将在采集服务接入后按分析结果刷新" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Foreground="#456"/></Grid></GroupBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <GroupBox Header="两面校正建议"><StackPanel Margin="12">
                    <TextBlock Text="校正面 A"/><TextBlock FontSize="24" FontWeight="Bold" Text="{Binding ResultA}" Margin="0,3,0,12"/>
                    <TextBlock Text="校正面 B"/><TextBlock FontSize="24" FontWeight="Bold" Text="{Binding ResultB}" Margin="0,3,0,12"/>
                    <Separator/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="结果仅在三次采集有效、试重响应充分且影响系数矩阵条件数合格时可用于实际校正。"/>
                </StackPanel></GroupBox>
            </StackPanel>
        </Grid>
        <GroupBox Grid.Row="2" Header="报警与操作日志" Margin="16,0,16,16"><DockPanel Margin="10"><Button DockPanel.Dock="Right" Content="确认全部" Command="{Binding AcknowledgeAlarmsCommand}" Padding="14,4"/><DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,12,0"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Width="100"/><DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80"/><DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></GroupBox>
    </Grid>
</Window>
